<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VantageFlow.Modules.Notes.Views.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowDefinitions="Auto,*">
        <Button Grid.Row="0" Content="New Note" Click="NewNote_Click" Margin="0,0,0,16" />

        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Notes}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="4" Margin="0,8">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Body}" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
