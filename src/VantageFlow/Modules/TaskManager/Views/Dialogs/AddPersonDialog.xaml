<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="VantageFlow.Modules.TaskManager.Views.Dialogs.AddPersonDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Add Person"
    PrimaryButtonText="Add"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <StackPanel Spacing="12" MinWidth="320">
        <TextBox x:Name="NameBox" Header="Name" PlaceholderText="e.g. Sarah" />
        <TextBox x:Name="RelationshipBox" Header="Relationship (optional)" PlaceholderText="e.g. Manager" />
    </StackPanel>
</ContentDialog>
