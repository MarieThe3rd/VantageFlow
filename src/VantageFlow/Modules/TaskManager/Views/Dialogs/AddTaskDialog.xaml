<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="VantageFlow.Modules.TaskManager.Views.Dialogs.AddTaskDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="New Task"
    PrimaryButtonText="Add"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="480">
        <StackPanel Spacing="12" MinWidth="360">
            <TextBox x:Name="TitleBox" Header="Title" PlaceholderText="What needs doing?" />
            <TextBox x:Name="NotesBox" Header="Notes (optional)" AcceptsReturn="True" Height="72" TextWrapping="Wrap" />
            <CheckBox x:Name="IdeaCheckBox" Content="Just an idea — not a real commitment" />

            <ComboBox
                x:Name="RequesterCombo"
                Header="Requester (optional)"
                PlaceholderText="Nobody — this is a self-directed task"
                DisplayMemberPath="Name"
                HorizontalAlignment="Stretch" />

            <ComboBox
                x:Name="RecipientCombo"
                Header="Recipient (optional) — who's expecting this back"
                PlaceholderText="Nobody — nothing owed to anyone"
                DisplayMemberPath="Name"
                HorizontalAlignment="Stretch" />

            <ComboBox
                x:Name="ProjectCombo"
                Header="Project (optional)"
                PlaceholderText="No project — a standalone task"
                DisplayMemberPath="Name"
                HorizontalAlignment="Stretch" />

            <ComboBox
                x:Name="SourceCombo"
                Header="Source (optional)"
                PlaceholderText="No particular source"
                DisplayMemberPath="Name"
                HorizontalAlignment="Stretch"
                SelectionChanged="SourceCombo_SelectionChanged" />

            <StackPanel x:Name="TicketFieldsPanel" Spacing="12" Visibility="Collapsed">
                <TextBox x:Name="TicketNumberBox" Header="Ticket number" />
                <TextBox x:Name="TicketLinkBox" Header="Ticket link" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
