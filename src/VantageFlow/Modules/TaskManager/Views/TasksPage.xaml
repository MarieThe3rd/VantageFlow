<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VantageFlow.Modules.TaskManager.Views.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:VantageFlow.Modules.TaskManager.Views.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:CommitmentToIdeaLabelConverter x:Key="CommitmentToIdeaLabelConverter" />
        <converters:RequesterToSummaryConverter x:Key="RequesterToSummaryConverter" />
        <converters:RecipientToSummaryConverter x:Key="RecipientToSummaryConverter" />
        <converters:ProjectToSummaryConverter x:Key="ProjectToSummaryConverter" />
        <converters:TaskSourceSummaryConverter x:Key="TaskSourceSummaryConverter" />
        <converters:DueDateToSummaryConverter x:Key="DueDateToSummaryConverter" />
    </Page.Resources>

    <Grid Padding="24" RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16" VerticalAlignment="Center">
            <Button Content="New Task" Click="NewTask_Click" />
            <Button Content="New Person" Click="NewPerson_Click" />
            <Button Content="New Project" Click="NewProject_Click" />
            <Button Content="New Source" Click="NewSource_Click" />
            <ComboBox
                Header="Show"
                ItemsSource="{x:Bind FilterOptions}"
                SelectedItem="{x:Bind ViewModel.Filter, Mode=TwoWay}"
                Margin="24,0,0,0" />
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.FilteredTasks}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <CheckBox
                            Content="Started"
                            IsChecked="{Binding IsStarted, Mode=TwoWay}"
                            Checked="TaskStarted_Changed"
                            Unchecked="TaskStarted_Changed" />
                        <CheckBox
                            Content="Done"
                            IsChecked="{Binding IsComplete, Mode=TwoWay}"
                            Checked="TaskComplete_Changed"
                            Unchecked="TaskComplete_Changed" />
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Commitment, Converter={StaticResource CommitmentToIdeaLabelConverter}}" Opacity="0.6" />
                        <TextBlock Text="{Binding Requester, Converter={StaticResource RequesterToSummaryConverter}}" Opacity="0.6" />
                        <TextBlock Text="{Binding Recipient, Converter={StaticResource RecipientToSummaryConverter}}" Opacity="0.6" />
                        <TextBlock Text="{Binding Project, Converter={StaticResource ProjectToSummaryConverter}}" Opacity="0.6" />
                        <TextBlock Text="{Binding Converter={StaticResource TaskSourceSummaryConverter}}" Opacity="0.6" />
                        <TextBlock Text="{Binding DueDate, Converter={StaticResource DueDateToSummaryConverter}}" Opacity="0.6" />
                        <Button Content="Edit" Click="EditTask_Click" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
