<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VantageFlow.Modules.TaskManager.Views.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:VantageFlow.Modules.TaskManager.Views.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:CommitmentToIdeaLabelConverter x:Key="CommitmentToIdeaLabelConverter" />
        <converters:RequesterToSummaryConverter x:Key="RequesterToSummaryConverter" />
    </Page.Resources>

    <Grid Padding="24" RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <Button Content="New Task" Click="NewTask_Click" />
            <Button Content="New Person" Click="NewPerson_Click" />
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Tasks}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Commitment, Converter={StaticResource CommitmentToIdeaLabelConverter}}" Opacity="0.6" />
                        <TextBlock Text="{Binding Requester, Converter={StaticResource RequesterToSummaryConverter}}" Opacity="0.6" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
